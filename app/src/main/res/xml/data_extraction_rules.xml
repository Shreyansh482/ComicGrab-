<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude large downloaded comics and archives from cloud backups -->
        <exclude domain="file" path="library" />
        <exclude domain="file" path="archives" />
        <exclude domain="file" path="temp" />
        <exclude domain="root" path="library" />
        <exclude domain="root" path="archives" />
        <exclude domain="root" path="temp" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library" />
        <include domain="file" path="archives" />
    </device-transfer>
</data-extraction-rules>
